# Template only. For DigitalOcean deployment, set these in App Platform Settings > Environment Variables.
# Never put real passwords or tokens in this file or commit a .env file.

# --- Supabase mode (Phase 50, preferred) ---
# Set BOTH to switch the login to real Supabase Auth. Get them from
# Supabase Dashboard > Project Settings > API. The anon key is safe in
# the browser; Row Level Security protects the data. Leave empty to use
# API mode or demo mode instead. See PHASE50_SUPABASE_AUTH.md.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- API mode (Phase 41 central API) ---
# Only used when the Supabase vars above are empty.
VITE_API_URL=https://YOUR-DIGITALOCEAN-API-DOMAIN
API_PORT=8787
PORT=8787
HOST=0.0.0.0
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
PGSSL=true
PGSSL_CA_BASE64=BASE64_ENCODED_DIGITALOCEAN_CA_CERTIFICATE
PG_POOL_MAX=10
JWT_SECRET=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARS
CORS_ORIGINS=null,https://YOUR-VERCEL-DOMAIN
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=GENERATE_A_UNIQUE_PASSWORD_AT_LEAST_12_CHARS
BOOTSTRAP_ADMIN_NAME=Dive More Administrator
