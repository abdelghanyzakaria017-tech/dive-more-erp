# Template only — copy to .env and fill in real values.
# Never put real passwords or tokens in this file or commit a .env file.

# --- API mode (Phase 51, own server — preferred) ---
# The frontend logs in against your own API server (server/ folder).
# Local office PC example: http://192.168.1.50:8787
# Cloud example: https://api.your-domain.com
# Leave empty (and leave the Supabase vars empty too) for demo mode.
VITE_API_URL=http://127.0.0.1:8787

# --- Server settings (server/ folder, Phase 51) ---
# Port/host for the API server.
API_PORT=8787
PORT=8787
HOST=0.0.0.0
# Long random secret for signing login tokens (32+ characters).
JWT_SECRET=replace-with-a-long-random-secret
# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# First owner account, created automatically on first start when the
# users table is empty. Password: 8+ chars with a letter and a digit.
BOOTSTRAP_ADMIN_EMAIL=owner@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password1
BOOTSTRAP_ADMIN_NAME=Dive More Owner

# --- Database ---
# Option A (zero-install, office PC): leave DATABASE_URL empty and the
# server uses a SQLite file at server/data/divemore.db (Node 22.5+).
# Option B (production, PHASE41): PostgreSQL connection string.
DATABASE_URL=
PGSSL=false
PG_POOL_MAX=10
# Optional: custom SQLite file location.
# SQLITE_PATH=C:\DiveMore\data\divemore.db

# --- Optional: real email delivery for password-reset codes ---
# Without these, reset codes are written to server/data/reset-outbox.log
# and printed in the server console.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=erp@example.com
# SMTP_PASS=replace-me
# SMTP_FROM=Dive More ERP <erp@example.com>

# --- Supabase mode (Phase 50, optional/legacy) ---
# Only used if BOTH are set AND you prefer Supabase Auth over your own
# server. Leave empty to use API mode above. See PHASE50_SUPABASE_AUTH.md.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
